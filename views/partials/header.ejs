<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="description" content="">
  <meta name="author" content="ACED Devops">
  <meta name="generator" content="Jekyll v4.1.1">
  <title>
    <%= body.title %> · BarcodeTool - ACED DevOps
  </title>

  <!-- Favicon and PWA Manifest -->
  <link rel="icon" href="<%= body.domain %>/favicon.svg" type="image/svg+xml">
  <link rel="manifest" href="<%= body.domain %>/manifest.json">
  <meta name="theme-color" content="#0A1420">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet">


  <style>
    .bd-placeholder-img {
      font-size: 1.125rem;
      text-anchor: middle;
      -webkit-user-select: none;
      -moz-user-select: none;
      user-select: none;
    }

    @media (min-width: 768px) {
      .bd-placeholder-img-lg {
        font-size: 3.5rem;
      }
    }

    textarea.collapsed {
      height: 40px;
      /* Adjust based on the desired height for two lines */
      overflow: hidden;
    }
      
  </style>

  <!-- Bootstrap core CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet"
  integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

  <!-- FontAwesome -->
  <script src="https://kit.fontawesome.com/5f30a8a83b.js" crossorigin="anonymous"></script>

  <!-- Barcode JS -->
  <script defer src="https://cdn.jsdelivr.net/jsbarcode/3.3.20/JsBarcode.all.min.js"></script>
  <!-- PDF export (Bulk Task label sheets) -->
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <!-- QR Code generation -->
  <script defer src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
  <!-- CSV Parsing (PapaParse) -->
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
  <!-- ZIP extraction (JSZip) -->
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

  <!-- Custom styles for this template -->
  <link href="<%= body.domain %>/css/barcode.css?v=<%= Date.now() %>" rel="stylesheet">
  
</head>

<body style="font-family:'IBM Plex Sans', -apple-system, sans-serif;">



            <!-- *******************DOMAIN HANDLING*************************** -->
            <span class="d-none" id="domain" domain="<%= body.domain %>">
            </span>