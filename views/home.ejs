<%- include("partials/header.ejs")%>

  <main class="form-signin app-shell" id="originalDoc">
    <!-- <form id="fileUpload" action="<%= body.domain %>/fileUpload" method="post" enctype="multipart/form-data"> -->
    <!-- <img class="mb-4" src="/docs/5.0/assets/brand/bootstrap-logo.svg" alt="" width="72" height="57"> -->

    <div class="container py-5 d-print-none app-header-block">

      <nav>
        <div class="nav-tabs " id="nav-tab" role="tablist">
          <ul class="nav justify-content-center app-tabs">
            <li class="nav-item">
              <button class="nav-link active text-reset" id="generate-tab" data-bs-toggle="tab" data-bs-target="#generate"
                type="button" role="tab" aria-controls="generate" aria-selected="true">Generate</button>
              <!-- <a class="nav-link active" aria-current="page" href="#">Active</a> -->
            </li>
            <li class="nav-item">
              <button class="nav-link text-reset" id="brand-finder-tab" data-bs-toggle="tab" data-bs-target="#brand-finder"
                type="button" role="tab" aria-controls="brand-finder" aria-selected="false">Brand Finder</button>
              <!-- <a class="nav-link" href="#">Link</a> -->
            </li>
            <li class="nav-item">
              <button class="nav-link text-reset" id="bulk-task-tab" data-bs-toggle="tab" data-bs-target="#bulk-task"
                type="button" role="tab" aria-controls="bulk-task" aria-selected="false">Bulk Task</button>
              <!-- <a class="nav-link" href="#">Link</a> -->
            </li>
            <li class="nav-item">
              <button class="nav-link text-reset" id="preload-scan-tab" data-bs-toggle="tab" data-bs-target="#preload-scan"
                type="button" role="tab" aria-controls="preload-scan" aria-selected="false">Preload Scan</button>
            </li>
            <li class="nav-item">
              <button class="nav-link text-reset" id="delimeter-tab" data-bs-toggle="tab" data-bs-target="#delimeter" type="button"
                role="tab" aria-controls="delimeter" aria-selected="false">Delimeter</button>
              <!-- <a class="nav-link" href="#">Link</a> -->
            </li>
            <li class="nav-item">
              <button class="nav-link text-reset" id="scanner-tab" data-bs-toggle="tab" data-bs-target="#scanner" type="button"
                role="tab" aria-controls="scanner" aria-selected="false">Scanner</button>
            </li>
            <li class="nav-item">
              <button class="nav-link text-reset" id="qrcode-tab" data-bs-toggle="tab" data-bs-target="#qrcode" type="button"
                role="tab" aria-controls="qrcode" aria-selected="false">QR Code</button>
            </li>
          </ul>
        </div>
      </nav>
    </div>



    <div class="tab-content " id="nav-tabContent ">
      <div class="tab-pane fade show active" id="generate" role="tabpanel" aria-labelledby="generate-tab" tabindex="0">
        <!-- start barcode copy -->
        <div class="container">
          <div class="mx-auto app-card">

            <div class="input-group d-print-none app-input-group">
              <span class="input-group-text" id="addon-wrapping">Barcode #</span>
              <input type="text" id="barcodeNumber" style="text-transform:uppercase"
                class="form-control" value="<%= (tracking ? tracking : '') %>" placeholder="start typing to reveal barcode" aria-label="tracking"
                aria-describedby="addon-wrapping">
                <button onclick="trackPackage()" id="trackPackageBtn"  class="disabled btn btn-accent">Track</button>
            </div>
            <input disabled type="text" id="barcodeBrand" style="text-transform:uppercase" class="d-none d-print-none form-control"
              placeholder="Brand Name" >

          <div class="p-0 m-auto text-center d-print-none mt-4" id="printArea" style="display: none;">
            <!-- Main Canvas -->
            <canvas class="pb-4 pt-0" id="barcode"></canvas>
          </div>

          <div class="d-block d-print-none">
            <div class="text-center">
              <button class="btn btn-outline-accent btn-sm disabled" id="printButton" data-bs-toggle="modal"
                data-bs-target="#printModal" onclick="clearNameField()"> Export Barcode</button>
            </div>
          </div>
        </div>
        <section class="" id="trackingInfoDisplay">
        
          <div class="mt-3 py-4 container col-md-8 offset-md-2  text-start">
            <div class="list-group placeholder-wave" id="trackingDetails">
        
            </div>
          </div>
          <div class="modal fade" id="trackingPictureModal" tabindex="-1" aria-labelledby="exampleModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
              <div class="modal-content">
                <div class="">
                  <img id="trackingPicture" src="" class="img-fluid" alt="...">
                </div>
        
                <div class="modal-footer d-print-none">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
              </div>
            </div>
        </section>
        <!-- end barcode copy -->
      </div>
    </div>

  


    <div class="tab-pane fade" id="brand-finder" role="tabpanel" aria-labelledby="brand-finder-tab" tabindex="0">
      <div class="container">
        <div class="mx-auto app-card">

          <label class="form-label">Barcode #</label>
          <div class="input-group app-input-group">
            <span class="input-group-text" id="addon-wrapping-bf">Barcode #</span>
            <input type="text" id="brandFinderInput" class="form-control " style="text-transform:uppercase"
              placeholder="search for brand" aria-label="tracking" aria-describedby="addon-wrapping-bf">
          </div>
          <div class="pt-3" id="">
            <p class="mb-0" id="brand"></p>
          </div>
        </div>
      </div>
    </div>

    <div class="tab-pane fade" id="bulk-task" role="tabpanel" aria-labelledby="bulk-task-tab" >
      <div class="container">
        <div class="mx-auto app-card d-print-none">
          <div class="mb-3">
            <label for="barcodesBatchText" class="form-label">Input Barcodes</label>
            <textarea class="form-control" placeholder="One entry per line, as shown below:&#10;'123456789'&#10;'123456789, 1234 Bluejay Dr, NW, Atlanta'" id="barcodesBatchText" rows="8"></textarea>
          </div>
          <span onclick="processBatch()" class="btn btn-primary">Display Barcodes</span>
        </div>

        <div class="col-sm-10 col-md-10 offset-sm-1 offset-md-1 pt-4">
          <div class="label-toolbar d-print-none">
            <button class="btn btn-outline-accent btn-sm disabled" id="bulkPrintBtn" onclick="printBulkLabels()">Print Labels</button>
            <button class="btn btn-secondary btn-sm disabled" id="bulkPdfBtn" onclick="exportBulkPdf()">Export as PDF</button>
            <select id="scrollSpeed" class="form-select form-select-sm d-inline-block w-auto ms-auto ms-md-2" style="font-size: .82rem; font-weight: 500; border-color: var(--border-strong); cursor: pointer;" disabled>
              <option value="1">Slow</option>
              <option value="2.5" selected>Medium</option>
              <option value="4.5">Fast</option>
              <option value="7">Super Fast</option>
            </select>
            <button class="btn btn-secondary btn-sm disabled ms-1" id="autoScrollBtn" onclick="toggleAutoScroll()">Auto Scroll</button>
            <span class="label-count" id="bulkLabelCount"></span>
          </div>
          <div class="pt-3" id="batchBarcodeDisplay">
            <p class="label-empty">Paste barcode entries above and tap Display Barcodes to generate a printable label sheet.</p>
          </div>
        </div>
      </div>
    </div>


    <div class="tab-pane fade" id="preload-scan" role="tabpanel" aria-labelledby="preload-scan-tab">
      <div class="container">
        
        <!-- 1. UPLOAD VIEW (when no manifest active) -->
        <div id="preloadUploadSection" class="preload-card-wide mx-auto">
          
          <!-- Persistent Session Resume Banner -->
          <div id="preloadResumeBanner" class="alert alert-info align-items-center justify-content-between flex-wrap gap-2 mb-4 d-none">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-clock-history fs-4"></i>
              <div>
                <strong>Active Preload Session Found:</strong>
                <span id="preloadResumeDetails">0 of 0 packages scanned</span>
              </div>
            </div>
            <div class="d-flex gap-2">
              <button class="btn btn-sm btn-primary" onclick="resumePreloadSession()">Resume Session</button>
              <button class="btn btn-sm btn-outline-danger" onclick="confirmResetPreload(true)">Discard & Start New</button>
            </div>
          </div>

          <div class="text-center mb-4">
            <h4 class="fw-bold mb-1"><i class="bi bi-upc-scan text-primary me-2"></i>Preload Scan</h4>
            <p class="text-muted mb-0">Upload package manifest (.csv or .zip) to start sorting and numbering packages</p>
          </div>

          <!-- Drag and drop zone (native label for 100% mobile compatibility) -->
          <label for="preloadFileInput" class="preload-dropzone mb-4 d-block text-center" id="preloadDropZone" style="cursor: pointer;">
            <i class="bi bi-cloud-arrow-up"></i>
            <h5 class="fw-bold mb-1">Click to browse or drag & drop manifest here</h5>
            <p class="text-muted small mb-2">Accepts <strong>.csv</strong> or <strong>.zip</strong> containing CSV</p>
            <span class="badge bg-light text-dark border mb-3">Auto-extracts Barcode, Seq No, Address</span>
            <div>
              <span class="btn btn-primary btn-sm px-3 py-2 fw-semibold">
                <i class="bi bi-folder2-open me-1"></i>Select Manifest File
              </span>
            </div>
            <input type="file" id="preloadFileInput" accept=".csv,text/csv,text/plain,.txt,.zip,application/zip,application/x-zip-compressed" style="opacity: 0; position: absolute; z-index: -1; width: 1px; height: 1px; pointer-events: none;">
          </label>

          <!-- Quick Paste Alternative -->
          <div class="text-center mb-2">
            <button class="btn btn-sm btn-link text-decoration-none text-muted" type="button" data-bs-toggle="collapse" data-bs-target="#preloadPasteCollapse" aria-expanded="false">
              <i class="bi bi-clipboard2-plus me-1"></i>Or paste raw CSV text directly
            </button>
          </div>
          <div class="collapse mb-3" id="preloadPasteCollapse">
            <div class="card card-body bg-light border">
              <textarea id="preloadPasteText" class="form-control mb-2" rows="5" placeholder='"Barcode","Seq No","Address"&#10;"1LS722712153166","114","5520 LAUREL OAK DR. SUWANEE. GA. 30024"'></textarea>
              <div class="text-end">
                <button class="btn btn-sm btn-primary" onclick="parsePastedManifest()">Load Pasted Data</button>
              </div>
            </div>
          </div>

          <!-- Guidance / Expected format -->
          <div class="p-3 bg-light rounded border small text-muted">
            <strong>Expected Manifest Format:</strong>
            <code class="d-block mt-1 text-dark">"Barcode","Last Event","Last Event time","Last GPS location","Seq No","Address"</code>
          </div>
        </div>

        <!-- 2. ACTIVE SESSION VIEW -->
        <div id="preloadActiveSection" class="preload-card-wide mx-auto" style="display:none;">
          
          <!-- Top bar: Manifest name, session actions -->
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-2 border-bottom">
            <div>
              <span class="badge bg-primary me-2"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Manifest</span>
              <strong id="preloadSessionFilename">manifest.csv</strong>
              <small class="text-muted ms-2" id="preloadSessionTime"></small>
            </div>
            <div class="d-flex gap-2">
              <button class="btn btn-sm btn-accent" id="preloadCompleteBtn" onclick="openPreloadCompleteModal()">
                <i class="bi bi-check-circle-fill me-1"></i>Complete Preload
              </button>
              <button class="btn btn-sm btn-outline-danger" onclick="confirmResetPreload(false)" title="Reset or switch manifest">
                <i class="bi bi-arrow-counterclockwise me-1"></i>New Manifest
              </button>
            </div>
          </div>

          <!-- 4-Stat Metrics Bar -->
          <div class="row g-2 mb-3">
            <div class="col-6 col-md-3">
              <div class="preload-stat-card">
                <div class="preload-stat-val text-dark" id="preloadTotalCount">0</div>
                <div class="preload-stat-lbl">Total Manifest</div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="preload-stat-card">
                <div class="preload-stat-val text-success" id="preloadScannedCount">0</div>
                <div class="preload-stat-lbl">Pre-scanned</div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="preload-stat-card">
                <div class="preload-stat-val text-warning" id="preloadPendingCount">0</div>
                <div class="preload-stat-lbl">Pending</div>
              </div>
            </div>
            <div class="col-6 col-md-3">
              <div class="preload-stat-card">
                <div class="preload-stat-val text-primary" id="preloadProgressPercent">0%</div>
                <div class="preload-stat-lbl">Progress</div>
              </div>
            </div>
          </div>

          <!-- Visual Progress Bar -->
          <div class="progress mb-4" style="height: 8px;">
            <div id="preloadProgressBar" class="progress-bar bg-success progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
          </div>

          <!-- PROMINENT LAST SCANNED PACKAGE DISPLAY -->
          <div class="preload-active-display mb-4" id="preloadActiveDisplay">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="text-uppercase small fw-bold text-muted">
                <i class="bi bi-broadcast me-1 text-primary"></i>Last Scanned Package
              </span>
              <div class="d-flex gap-2 align-items-center">
                <button type="button" class="btn btn-sm btn-link p-0 text-muted" id="preloadSoundToggle" onclick="togglePreloadSound()" title="Toggle scan sound">
                  <i class="bi bi-volume-up-fill fs-5 text-primary" id="preloadSoundIcon"></i>
                </button>
                <button type="button" class="btn btn-sm btn-link p-0 text-muted" id="preloadVibrateToggle" onclick="togglePreloadVibrate()" title="Toggle vibration">
                  <i class="bi bi-phone-vibrate fs-5 text-primary" id="preloadVibrateIcon"></i>
                </button>
              </div>
            </div>

            <!-- Sequence Number Badge -->
            <div class="preload-seq-badge" id="preloadLastSeq">#---</div>
            
            <!-- Delivery Address -->
            <div class="preload-address-text" id="preloadLastAddress">Scan a package barcode to begin numbering</div>

            <!-- Barcode and scan timestamp -->
            <div class="preload-barcode-text" id="preloadLastBarcode">Ready for scanner</div>
          </div>

          <!-- SCAN INPUT CONTROLS -->
          <div class="card p-3 mb-4 bg-light border">
            <div class="row g-2 align-items-center">
              <div class="col-md-7">
                <div class="input-group">
                  <span class="input-group-text bg-white"><i class="bi bi-upc-scan"></i></span>
                  <input type="text" id="preloadScanInput" class="form-control" placeholder="Scan or enter barcode (auto-reads on Enter)..." style="text-transform: uppercase;" autocomplete="off">
                  <button class="btn btn-primary" type="button" onclick="submitPreloadManualScan()">Submit</button>
                </div>
              </div>
              <div class="col-md-5 d-flex gap-2 justify-content-md-end">
                <button class="btn btn-outline-secondary w-100" id="preloadCamToggleBtn" onclick="togglePreloadCamera()">
                  <i class="bi bi-camera me-1"></i><span id="preloadCamBtnText">Start Camera Scanner</span>
                </button>
              </div>
            </div>

            <!-- Camera Viewfinder (collapsible) -->
            <div id="preloadCamSection" class="mt-3 text-center" style="display:none;">
              <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                <label class="small text-muted mb-0 fw-bold">Camera Viewfinder</label>
                <div class="d-flex align-items-center gap-2">
                  <label class="small text-muted mb-0">Carrier Filter:</label>
                  <select id="preloadCarrierFilter" class="form-select form-select-sm w-auto">
                    <option value="general">All Supported Carriers</option>
                    <option value="ontrac">OnTrac / LaserShip</option>
                    <option value="speedx">SpeedX</option>
                    <option value="gopro">GoPro</option>
                    <option value="any">Allow Any</option>
                  </select>
                </div>
              </div>
              <div class="preload-cam-wrap">
                <video id="preloadVideo" playsinline muted></video>
                <div class="preload-scan-box" id="preloadScanBox"></div>
                <div class="preload-cam-status" id="preloadCamStatus" style="display:none;">
                  <span id="preloadCamStatusText">Starting camera...</span>
                </div>
              </div>
            </div>
          </div>

          <!-- MANIFEST TABLE & SEARCH/FILTER TOOLBAR -->
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 380px;">
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" id="preloadFilterSearch" class="form-control" placeholder="Filter by Seq #, Address, or Barcode..." oninput="renderPreloadTable()">
              </div>
            </div>
            
            <div class="d-flex align-items-center gap-2">
              <div class="btn-group btn-group-sm" role="group" id="preloadFilterStatusGroup">
                <button type="button" class="btn btn-outline-primary active" data-status="all" onclick="setPreloadStatusFilter('all')">All (<span id="filterCountAll">0</span>)</button>
                <button type="button" class="btn btn-outline-primary" data-status="pending" onclick="setPreloadStatusFilter('pending')">Pending (<span id="filterCountPending">0</span>)</button>
                <button type="button" class="btn btn-outline-primary" data-status="prescanned" onclick="setPreloadStatusFilter('prescanned')">Pre-scanned (<span id="filterCountScanned">0</span>)</button>
              </div>
            </div>
          </div>

          <!-- Table Container -->
          <div class="preload-table-wrap table-responsive">
            <table class="table table-hover table-striped align-middle mb-0" id="preloadManifestTable">
              <thead>
                <tr>
                  <th style="width: 90px;">Seq #</th>
                  <th style="width: 190px;">Barcode</th>
                  <th>Address</th>
                  <th style="width: 130px; text-align: center;">Status</th>
                  <th style="width: 100px; text-align: right;">Action</th>
                </tr>
              </thead>
              <tbody id="preloadTableBody">
                <!-- Injected via JavaScript -->
              </tbody>
            </table>
          </div>
          <div class="text-end mt-2">
            <small class="text-muted" id="preloadShowingCount">Showing 0 packages</small>
          </div>

        </div>

      </div>
    </div>


    <div class="tab-pane fade" id="delimeter" role="tabpanel" aria-labelledby="delimeter-tab">
      <div class="container">
        <div class="mx-auto app-card">
          <div class="mb-3">
            <label for="delimeterText" class="form-label">Input Text</label>
            <textarea class="form-control"
              placeholder="One entry per line, as shown below:&#10;'Santi - 30338 30346 30360 30341 30319 - 115'"
              id="delimeterText" rows="8"></textarea>
          </div>
          <div class="d-flex gap-2 flex-wrap align-items-center">
            <span onclick="processDelimeter()" class="btn btn-primary">Reformat</span>
            <span onclick="copyDelimeterOutput()" class="btn btn-secondary btn-sm" id="delimeterCopyBtn">Copy Output</span>
          </div>
          <div id="outputText"></div>
        </div>
      </div>
    </div>

    <div class="tab-pane fade" id="scanner" role="tabpanel" aria-labelledby="scanner-tab">
      <div class="container">
        <div class="col-sm-12 col-md-10 offset-md-1" style="width: 100%; height: calc(100vh - 150px); min-height: 550px;">
          <iframe src="<%= body.domain %>/scanner.html" style="width: 100%; height: 100%; border: none;"></iframe>
        </div>
      </div>
    </div>

    <div class="tab-pane fade" id="qrcode" role="tabpanel" aria-labelledby="qrcode-tab">
      <div class="container">
        <div class="app-card mx-auto" style="max-width: 650px;">
          
          <div class="d-flex align-items-center mb-2">
            <label class="form-label mb-0">QR Code Content</label>
            <button class="btn btn-sm btn-link text-muted ms-auto p-0" id="qrSettingsBtn" title="QR Code Settings" onclick="$('#qrSettingsPanel').slideToggle('fast')">
              <i class="bi bi-gear-fill" style="font-size: 1.25rem;"></i>
            </button>
          </div>
          
          <div class="input-group app-input-group mb-3">
            <input type="text" id="qrInput" class="form-control" placeholder="Enter text or URL to generate QR code">
          </div>
          
          <!-- Settings Panel -->
          <div id="qrSettingsPanel" class="p-3 mb-4 rounded" style="display:none; background: var(--surface-2); border: 1px solid var(--border);">
             <div class="row g-2">
                <div class="col-6">
                   <label class="small text-muted mb-1" style="font-size:.8rem; font-weight:600;">Dark Color</label>
                   <input type="color" id="qrColorDark" class="form-control form-control-color w-100" value="#000000">
                </div>
                <div class="col-6">
                   <label class="small text-muted mb-1" style="font-size:.8rem; font-weight:600;">Light Color</label>
                   <input type="color" id="qrColorLight" class="form-control form-control-color w-100" value="#ffffff">
                </div>
                <div class="col-6 mt-3">
                   <label class="small text-muted mb-1" style="font-size:.8rem; font-weight:600;">Error Correction</label>
                   <select id="qrCorrection" class="form-select form-select-sm" style="font-size: .85rem; border-color: var(--border-strong);">
                      <option value="L">Low (L)</option>
                      <option value="M" selected>Medium (M)</option>
                      <option value="Q">Quartile (Q)</option>
                      <option value="H">High (H)</option>
                   </select>
                </div>
                <div class="col-6 mt-3">
                   <label class="small text-muted mb-1" style="font-size:.8rem; font-weight:600;">Margin</label>
                   <input type="number" id="qrMargin" class="form-control form-control-sm" style="font-size: .85rem; border-color: var(--border-strong);" value="2" min="0" max="10">
                </div>
             </div>
          </div>

          <div class="p-0 m-auto text-center mt-2" id="qrPrintArea" style="display: none;">
            <canvas class="pb-3 pt-0" id="qrCanvas" style="max-width:100%; border-radius: var(--radius-sm);"></canvas>
          </div>

          <div class="text-center d-print-none mt-3">
            <button class="btn btn-outline-accent btn-sm disabled" id="exportQrBtn" onclick="exportQrCode()">Export to PNG</button>
          </div>

        </div>
      </div>
    </div>
      <!-- <div class="tab-pane fade" id="nav-contact" role="tabpanel" aria-labelledby="nav-contact-tab" tabindex="0">...</div> -->
      <!-- <div class="tab-pane fade" id="nav-disabled" role="tabpanel" aria-labelledby="nav-disabled-tab" tabindex="0">...</div> -->
    </div>




    <div class="modal fade" id="printModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header text-center">
            <!-- <p class="">Print Barcode</p> -->
            <h5 class="modal-title">Print Barcode</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <!-- Hidden Name Field -->
          <input type="text" id="description" class="form-control d-none border-0 pt-5 pb-0 d-print-block text-center"
            placeholder="Type customers name or address to help iddentify barcode" aria-label="Username"
            aria-describedby="basic-addon1">

          <div class="modal-body text-center container">
            <!-- Visible NameField -->
            <input type="text" id="barcodeDescription" class="form-control d-print-none text-center"
              placeholder="Type a description to help iddentify the barcode" aria-label="Username"
              aria-describedby="basic-addon1">
              <!-- Canvas -->
            <canvas  class="pt-1 pb-3" id="barcodeModal">
              
            </canvas>
          </div>

          <div class="py-3 text-muted d-none d-print-block ">
            <p class="mt-5 mb-3 text-muted"><strong>&copy; Barcode</strong> by ACED DevOps</p>
            </p>
          </div>

          <div class="modal-footer d-print-none">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <a id="downloadLink" download="barcode.jpg" onclick="downloadImage(this)" class="btn btn-accent" >Save Image</a>
            <button type="button" onclick="printBarcode()" class="btn btn-outline-accent">Print</button>
          </div>
        </div>
      </div>
    </div>

    <!-- PRELOAD COMPLETION MODAL -->
    <div class="modal fade" id="preloadCompleteModal" tabindex="-1" aria-labelledby="preloadCompleteModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="preloadCompleteModalLabel">
              <i class="bi bi-clipboard-check text-success me-2"></i>Preload Process Complete
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-start">
            <div class="alert alert-success d-flex align-items-center gap-3 mb-4">
              <i class="bi bi-check-circle-fill fs-2 text-success"></i>
              <div>
                <h6 class="mb-1 fw-bold">Preload Scanning Finished</h6>
                <div id="preloadCompleteSummaryText">
                  Successfully scanned <strong>0</strong> of <strong>0</strong> packages.
                </div>
              </div>
            </div>

            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <div class="p-3 border rounded text-center bg-light">
                  <div class="fs-4 fw-bold text-success" id="modalScannedCount">0</div>
                  <small class="text-muted text-uppercase fw-semibold">Pre-Scanned</small>
                </div>
              </div>
              <div class="col-md-4">
                <div class="p-3 border rounded text-center bg-light">
                  <div class="fs-4 fw-bold text-warning" id="modalPendingCount">0</div>
                  <small class="text-muted text-uppercase fw-semibold">Excluded / Missing</small>
                </div>
              </div>
              <div class="col-md-4">
                <div class="p-3 border rounded text-center bg-light">
                  <div class="fs-4 fw-bold text-primary" id="modalTotalCount">0</div>
                  <small class="text-muted text-uppercase fw-semibold">Total Manifest</small>
                </div>
              </div>
            </div>

            <h6 class="fw-bold mb-2">Scanned Barcodes (Excluded Unscanned):</h6>
            <textarea id="preloadScannedListTextarea" class="form-control font-monospace mb-3" rows="6" readonly style="font-size: 0.88rem;"></textarea>

            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
              <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-primary btn-sm" id="preloadCopyScannedBtn" onclick="copyPreloadScannedBarcodes()">
                  <i class="bi bi-clipboard me-1"></i>Copy Scanned Barcodes
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="downloadPreloadScannedTxt()">
                  <i class="bi bi-file-text me-1"></i>Download .txt
                </button>
              </div>
              <button class="btn btn-success btn-sm fw-bold" onclick="sendPreloadToBulkTask()">
                <i class="bi bi-arrow-right-circle-fill me-1"></i>Send to Bulk Task for Final Load Scan
              </button>
            </div>
          </div>
          <div class="modal-footer d-flex justify-content-between">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="button" class="btn btn-accent" id="preloadExportPdfBtn" onclick="exportPreloadPdf()">
              <i class="bi bi-file-earmark-pdf-fill me-1"></i>Download Scannable Barcodes (PDF)
            </button>
          </div>
        </div>
      </div>
    </div>


    <!-- <button class="w-100 btn btn-lg btn-primary" type="submit">Upload <i class="fas fa-file-upload"></i></button> -->


    <!-- </form> -->

    <!-- Button trigger modal -->

    <div class="fixed-bottom bg-light text-muted d-print-none app-footer">

      <p class="mt-3 mb-3 text-muted"><strong>&copy; Barcode</strong> by ACED DevOps</p>
      </p>
    </div>

    <div id="appToast" class="d-print-none"></div>

  </main>




  <!-- JavaScript Bundle with Popper -->
  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery -->
  <script defer src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

  <!-- Script -->
  <script defer src="<%= body.domain %>/js/barcode.js"></script>
  <!-- <script src="js/barcode.js"></script> -->

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const footer = document.querySelector('.app-footer');
      if(footer) {
        document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(tab => {
          tab.addEventListener('shown.bs.tab', function (event) {
            if (event.target.id === 'scanner-tab') {
              footer.style.display = 'none';
            } else {
              footer.style.display = 'block';
            }
          });
        });
      }
    });
  </script>
  </body>

  </html>
