<%- include("partials/header.ejs")%>

<% 
  const isTracking = (typeof tracking !== 'undefined' && tracking);
  const activeTab = isTracking ? 'generate' : 'preload-scan';
%>

  <main class="app-shell" id="originalDoc">

    <!-- Field-Ops App Top Bar -->
    <header class="topbar d-print-none">
      <div class="topbar-row">
        <a href="<%= body.domain %>/" class="brand">
          <div class="brand-mark">
            <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-width="2">
              <rect x="3" y="6" width="2" height="12"/>
              <rect x="7" y="6" width="1" height="12"/>
              <rect x="10" y="3" width="3" height="18"/>
              <rect x="15" y="6" width="2" height="12"/>
              <rect x="19" y="6" width="2" height="12"/>
            </svg>
          </div>
          <span class="brand-name">Barcode</span>
        </a>
        <div style="display:flex; align-items:center; gap:12px;">
          <div class="sync">
            <span class="sync-dot"></span>
            <span id="syncStateText">Synced</span>
          </div>
          <div class="avatar" title="All Tools" data-bs-toggle="modal" data-bs-target="#moreToolsModal" style="cursor:pointer;">AD</div>
        </div>
      </div>
    </header>

    <!-- Main Scroll Area -->
    <div class="main">
      <div class="tab-content" id="nav-tabContent">

        <!-- 1. PRELOAD SCAN (MANIFEST) TAB -->
        <div class="tab-pane fade <%= activeTab === 'preload-scan' ? 'show active' : '' %>" id="preload-scan" role="tabpanel" aria-labelledby="preload-scan-tab">

          <!-- Upload View (shown when no manifest is active) -->
          <div id="preloadUploadSection">
            
            <!-- Persistent Session Resume Banner -->
            <div id="preloadResumeBanner" class="alert alert-info align-items-center justify-content-between flex-wrap gap-2 mb-3 d-none">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history fs-5"></i>
                <div class="small">
                  <strong>Active Session:</strong>
                  <span id="preloadResumeDetails">0 of 0 scanned</span>
                </div>
              </div>
              <div class="d-flex gap-2">
                <button class="btn btn-sm primary py-1 px-2" style="font-size:12px;" onclick="resumePreloadSession()">Resume</button>
                <button class="btn btn-sm ghost py-1 px-2" style="font-size:12px; color:var(--accent-ink);" onclick="confirmResetPreload(true)">Discard</button>
              </div>
            </div>

            <div class="panel">
              <div class="manifest-head mb-3">
                <div>
                  <div class="manifest-title">Preload Manifest Upload</div>
                  <div class="manifest-sub">Upload manifest to start sorting and package numbering</div>
                </div>
                <div class="chip">STANDBY</div>
              </div>

              <!-- Native Label Dropzone -->
              <label for="preloadFileInput" class="preload-dropzone mb-3 d-block text-center" id="preloadDropZone">
                <i class="bi bi-cloud-arrow-up"></i>
                <div class="fw-bold mb-1" style="font-size:15px;">Click to browse or drop manifest here</div>
                <div class="small text-muted mb-2">Accepts <strong>.csv</strong>, <strong>.xls</strong>, <strong>.xlsx</strong>, or <strong>.zip</strong> (multi-file supported)</div>
                <div>
                  <span class="btn primary" style="padding:8px 18px; font-size:13px;">
                    <i class="bi bi-folder2-open me-1"></i>Select Manifest File
                  </span>
                </div>
                <input type="file" id="preloadFileInput" accept=".csv,.tsv,.txt,.xls,.xlsx,.zip,text/csv,text/plain,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/zip,application/x-zip-compressed" style="opacity: 0; position: absolute; z-index: -1; width: 1px; height: 1px; pointer-events: none;">
              </label>

              <!-- Quick Paste Option -->
              <div class="text-center mb-2">
                <button class="btn-link-sub" type="button" data-bs-toggle="collapse" data-bs-target="#preloadPasteCollapse" aria-expanded="false">
                  <i class="bi bi-clipboard2-plus me-1"></i>Or paste raw CSV / tab-delimited text directly
                </button>
              </div>
              <div class="collapse mb-3" id="preloadPasteCollapse">
                <div class="p-3 bg-light rounded border">
                  <textarea id="preloadPasteText" class="form-control mono mb-2" rows="4" style="font-size:12px;" placeholder='"Barcode","Seq No","Address" or "Tracking No" [Tab] "Sequence" [Tab] "Street Address" ...'></textarea>
                  <div class="text-end">
                    <button class="btn primary" style="padding:6px 14px; font-size:12px;" onclick="parsePastedManifest()">Load Pasted Data</button>
                  </div>
                </div>
              </div>

              <!-- Format note -->
              <div class="p-2 rounded border small text-muted" style="background:var(--paper); font-size:11.5px;">
                <div class="d-flex align-items-center justify-content-between mb-1">
                  <strong class="text-dark"><i class="bi bi-magic me-1" style="color:var(--accent);"></i>Universal Manifest Auto-Detection:</strong>
                  <span class="badge bg-light text-secondary border">LaserShip · SpeedX · Circuit · RoadWarrior · Generic</span>
                </div>
                <div>Automatically detects and normalizes <strong>Barcode / Tracking</strong>, <strong>Sequence / Stop #</strong>, <strong>Address</strong>, <strong>Unit / Apt</strong>, and <strong>Zip Code</strong> from any CSV, Excel (.xlsx/.xls), or ZIP. Serial numbers and row indices are automatically excluded.</div>
              </div>
            </div>
          </div>

          <!-- Active Manifest Dashboard -->
          <div id="preloadActiveSection" style="display:none;">

            <!-- Manifest Head & Stat Strip Panel -->
            <div class="panel">
              <div class="manifest-head">
                <div>
                  <div class="manifest-title" id="preloadSessionFilename">manifest.csv</div>
                  <div class="manifest-sub" id="preloadSessionTime">Loaded Just Now</div>
                </div>
                <div class="chip active" id="preloadSessionChip">ACTIVE</div>
              </div>

              <!-- Schema & Courier Auto-Detection Badges -->
              <div class="d-flex flex-wrap align-items-center gap-2 mt-2 pt-2 border-top" id="preloadSchemaInfoRow">
                <span class="badge bg-primary" id="preloadCourierBadge" style="font-size:11px;">Manifest Loaded</span>
                <span class="badge bg-warning text-dark d-none" id="preloadUnsequencedBadge" style="font-size:11px;">
                  <i class="bi bi-exclamation-triangle-fill me-1"></i>UNSEQUENCED BATCH
                </span>
                <span class="small text-muted" id="preloadSchemaMappingText" style="font-size:11px;">
                  Auto-mapped headers
                </span>
              </div>

              <div class="stat-strip">
                <div class="stat-cell">
                  <div class="stat-num" id="preloadTotalCount">0</div>
                  <div class="stat-label">Total</div>
                </div>
                <div class="stat-cell">
                  <div class="stat-num" style="color:var(--success)" id="preloadScannedCount">0</div>
                  <div class="stat-label">Scanned</div>
                </div>
                <div class="stat-cell">
                  <div class="stat-num" style="color:var(--warn)" id="preloadPendingCount">0</div>
                  <div class="stat-label">Pending</div>
                </div>
                <div class="stat-cell">
                  <div class="stat-num" style="color:var(--blue)" id="preloadProgressPercent">0%</div>
                  <div class="stat-label">Progress</div>
                </div>
              </div>

              <div class="progress-row">
                <div class="progress-track"><div class="progress-fill" id="preloadProgressFill"></div></div>
                <div class="progress-pct" id="preloadProgressFraction">0 / 0</div>
              </div>
            </div>

            <!-- Active Scan & Box Numbering Console Panel -->
            <div class="panel preload-console-panel">
              <!-- Warehouse Sorting Mode & Zip Filter Strip -->
              <div class="preload-control-strip mb-2 p-2 rounded border" style="background:var(--paper);">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                  <!-- Scan Mode Selector -->
                  <div class="d-flex align-items-center gap-2">
                    <span class="small fw-bold text-muted" style="font-size:11.5px;">
                      <i class="bi bi-sliders me-1"></i>Scan Mode:
                    </span>
                    <div class="btn-group btn-group-sm" id="preloadScanModeGroup">
                      <button type="button" class="btn btn-outline-secondary active py-0 px-2" style="font-size:11px;" id="modeVerifyBtn" onclick="setPreloadScanMode('verify')" title="Verify against sequence numbers in manifest">
                        <i class="bi bi-check2-circle me-1"></i>Verify Manifest
                      </button>
                      <button type="button" class="btn btn-outline-secondary py-0 px-2" style="font-size:11px;" id="modeAssignBtn" onclick="setPreloadScanMode('assign')" title="Assign sequential stop numbers (1, 2, 3...) as packages are scanned">
                        <i class="bi bi-sort-numeric-down me-1"></i>Scan &amp; Assign Seq
                      </button>
                    </div>
                    <span class="badge bg-light text-muted border" id="preloadAssignCounterBadge" style="font-size:10px; display:none;">Next: #1</span>
                  </div>

                  <!-- Zip Code Filter -->
                  <div class="d-flex align-items-center gap-1">
                    <span class="text-muted small" style="font-size:11.5px;">Zip Code:</span>
                    <select id="preloadZipFilter" class="form-select form-select-sm w-auto py-0 px-2" style="font-size:11px; height:26px;" onchange="handlePreloadZipFilterChange()">
                      <option value="all">All Zip Codes</option>
                    </select>
                  </div>
                </div>

                <!-- Unsequenced batch notice -->
                <div id="preloadUnsequencedNotice" class="small text-warning mt-1 pt-1 border-top d-none" style="font-size:11px;">
                  <i class="bi bi-exclamation-circle-fill me-1"></i>Unsequenced batch detected (e.g. SpeedX all 0s). Use <strong>Scan &amp; Assign Seq</strong> to number boxes sequentially as you scan, or filter by Zip Code.
                </div>
              </div>

              <!-- TOP ROW: Large Display on Left + Compact Rectangular Camera Viewfinder on Right -->
              <div class="preload-top-scanner-grid mb-2">
                
                <!-- LEFT: Large Sequence Number Display -->
                <div class="preload-seq-card" id="preloadSeqCard">
                  <div class="d-flex justify-content-between align-items-center mb-1 w-100">
                    <span class="text-uppercase small fw-bold text-muted" style="font-size:10.5px; letter-spacing:0.04em;">
                      <i class="bi bi-broadcast me-1" style="color:var(--accent);"></i>Sequence #
                    </span>
                    <div class="d-flex gap-1 align-items-center">
                      <button type="button" class="btn-icon p-0" id="preloadSoundToggle" onclick="togglePreloadSound()" title="Toggle scan sound">
                        <i class="bi bi-volume-up-fill" id="preloadSoundIcon" style="color:var(--accent); font-size:1rem;"></i>
                      </button>
                      <button type="button" class="btn-icon p-0" id="preloadVibrateToggle" onclick="togglePreloadVibrate()" title="Toggle vibration">
                        <i class="bi bi-phone-vibrate" id="preloadVibrateIcon" style="color:var(--accent); font-size:1rem;"></i>
                      </button>
                    </div>
                  </div>
                  <div class="preload-seq-badge" id="preloadLastSeq">#---</div>
                  <div class="preload-seq-status small text-muted" id="preloadSeqStatus">Ready for scan</div>
                </div>

                <!-- RIGHT: Compact Rectangular Camera Viewfinder (~85-95px tall, ~15% space) -->
                <div class="preload-compact-cam-box" id="preloadCompactCamBox">
                  <!-- Inactive Placeholder State -->
                  <div class="preload-cam-placeholder" id="preloadCamPlaceholder" onclick="togglePreloadCamera()" title="Tap to start camera scanner">
                    <div class="preload-cam-placeholder-icon">
                      <i class="bi bi-camera-fill"></i>
                    </div>
                    <span class="preload-cam-placeholder-text">Start Camera</span>
                    <span class="preload-cam-placeholder-sub">Tap to scan</span>
                  </div>

                  <!-- Active Video Viewfinder Wrap -->
                  <div class="preload-cam-wrap" id="preloadCamWrap" style="display:none;">
                    <video id="preloadVideo" playsinline muted></video>
                    <div class="preload-scan-box" id="preloadScanBox">
                      <div class="preload-scan-line"></div>
                    </div>
                    <div class="preload-cam-status" id="preloadCamStatus" style="display:none;">
                      <span id="preloadCamStatusText" style="font-size:11px;">Loading...</span>
                    </div>
                    <button type="button" class="preload-cam-mini-toggle" onclick="togglePreloadCamera()" title="Stop camera">
                      <i class="bi bi-x-circle-fill"></i>
                    </button>
                  </div>
                </div>

              </div>

              <!-- DETAILS: Address and Barcode (Immediately below display & camera) -->
              <div class="preload-details-card mb-2">
                <div class="preload-address-text" id="preloadLastAddress">Scan a barcode to display sequence #</div>
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-1 mt-1">
                  <div class="preload-barcode-text" id="preloadLastBarcode">Ready for scanner</div>
                  <div id="preloadCarrierTag" class="badge bg-light text-muted border" style="font-size:10px;">Auto-Detect</div>
                </div>
              </div>

              <!-- Barcode Manual Scan Input -->
              <div class="d-flex gap-2 mb-2">
                <div class="scan-input-wrap flex-grow-1">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h3M17 4h3v3M20 17v3h-3M7 20H4v-3"/><rect x="9" y="9" width="6" height="6"/></svg>
                  <input type="text" id="preloadScanInput" class="scan-input mono" placeholder="Scan or enter barcode..." style="text-transform: uppercase;" autocomplete="off">
                </div>
                <button class="btn primary" style="flex:0 0 auto; padding:9px 16px; font-size:13.5px;" type="button" onclick="submitPreloadManualScan()">Read</button>
              </div>

              <!-- Carrier Filter and Quick Action Row -->
              <div class="d-flex justify-content-between align-items-center px-1">
                <button class="btn-link-sub" type="button" id="preloadCamAltToggle" onclick="togglePreloadCamera()">
                  <i class="bi bi-camera me-1"></i><span id="preloadCamBtnText">Turn Camera On</span>
                </button>
                <div class="d-flex align-items-center gap-1">
                  <span class="text-muted" style="font-size:11px;">Carrier:</span>
                  <select id="preloadCarrierFilter" class="form-select form-select-sm w-auto py-0 px-2" style="font-size:11px; height:26px;">
                    <option value="general">All Supported Carriers</option>
                    <option value="ontrac">OnTrac / LaserShip</option>
                    <option value="speedx">SpeedX</option>
                    <option value="gopro">GoPro</option>
                    <option value="any">Allow Any</option>
                  </select>
                </div>
              </div>

            </div>

            <!-- Live Scan Feed Panel -->
            <div class="panel" style="padding-top:14px;">
              <div class="section-label">
                Live scan feed <span id="preloadLiveScanCount">Recent scans</span>
              </div>
              <div id="preloadLiveScanFeed">
                <p class="text-muted small text-center py-2 mb-0">No scans recorded in this session yet</p>
              </div>
            </div>

            <!-- Manifest Records & Filters Panel -->
            <div class="panel">
              <div class="section-label">
                <span>Manifest Records (<span id="preloadShowingCount">0</span>)</span>
                <button class="btn-link-sub" type="button" data-bs-toggle="collapse" data-bs-target="#preloadTableCollapse">Toggle View</button>
              </div>
              <div class="collapse show" id="preloadTableCollapse">
                <div class="d-flex flex-wrap gap-2 mb-2">
                  <input type="text" id="preloadFilterSearch" class="form-control form-control-sm" placeholder="Filter by Seq #, Address, Barcode..." oninput="renderPreloadTable()">
                </div>
                <div class="btn-group btn-group-sm w-100 mb-3" id="preloadFilterStatusGroup">
                  <button type="button" class="btn btn-outline-secondary active" data-status="all" onclick="setPreloadStatusFilter('all')">All (<span id="filterCountAll">0</span>)</button>
                  <button type="button" class="btn btn-outline-secondary" data-status="pending" onclick="setPreloadStatusFilter('pending')">Pending (<span id="filterCountPending">0</span>)</button>
                  <button type="button" class="btn btn-outline-secondary" data-status="prescanned" onclick="setPreloadStatusFilter('prescanned')">Scanned (<span id="filterCountScanned">0</span>)</button>
                </div>
                <div class="preload-table-wrap">
                  <table class="table table-hover align-middle mb-0" id="preloadManifestTable">
                    <thead>
                      <tr>
                        <th style="width:65px;">Seq #</th>
                        <th>Barcode</th>
                        <th>Address</th>
                        <th style="width:95px; text-align:center;">Status</th>
                        <th style="width:75px; text-align:right;">Action</th>
                      </tr>
                    </thead>
                    <tbody id="preloadTableBody"></tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- Bottom Action Bar for Preload -->
            <div class="actionbar d-flex justify-content-between align-items-center gap-2">
              <div class="btn ghost" onclick="confirmResetPreload(false)">New manifest</div>
              <div class="d-flex gap-2">
                <div class="dropdown">
                  <button class="btn ghost dropdown-toggle" type="button" id="preloadExportMenuBtn" data-bs-toggle="dropdown" aria-expanded="false" style="padding:10px 14px; font-size:13px;">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Export
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end shadow border" aria-labelledby="preloadExportMenuBtn" style="font-size:12.5px; min-width:240px;">
                    <li><h6 class="dropdown-header text-uppercase fw-bold text-muted" style="font-size:10.5px;">Route Planning Services</h6></li>
                    <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="exportUniversalManifest('circuit')"><i class="bi bi-signpost-split me-2 text-primary"></i>Export for Spoke / Circuit (CSV)</a></li>
                    <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="exportUniversalManifest('roadwarrior')"><i class="bi bi-compass me-2 text-danger"></i>Export for RoadWarrior (CSV)</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header text-uppercase fw-bold text-muted" style="font-size:10.5px;">Warehouse Manifest Files</h6></li>
                    <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="exportUniversalManifest('xlsx')"><i class="bi bi-file-earmark-excel me-2 text-success"></i>Download Full Manifest (XLSX)</a></li>
                    <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="exportUniversalManifest('csv')"><i class="bi bi-filetype-csv me-2 text-secondary"></i>Download Clean Manifest (CSV)</a></li>
                    <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="exportUniversalManifest('scanned_only')"><i class="bi bi-check2-all me-2 text-info"></i>Export Scanned Only (CSV)</a></li>
                  </ul>
                </div>
                <div class="btn primary" id="preloadCompleteBtn" onclick="openPreloadCompleteModal()">Complete preload</div>
              </div>
            </div>

          </div>
        </div>

        <!-- 2. GENERATE TAB (Unified: Code 128 + QR Code) -->
        <div class="tab-pane fade <%= activeTab === 'generate' ? 'show active' : '' %>" id="generate" role="tabpanel" aria-labelledby="generate-tab" tabindex="0">
          <div class="panel">
            
            <!-- Generation Type Switcher -->
            <div class="gen-subnav mb-3">
              <button type="button" class="gen-subtab active" id="genSubtabBarcode" onclick="switchGenerateMode('barcode')">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;margin-right:6px;vertical-align:-2px;"><rect x="3" y="6" width="2" height="12"/><rect x="7" y="6" width="1" height="12"/><rect x="10" y="3" width="3" height="18"/><rect x="15" y="6" width="2" height="12"/><rect x="19" y="6" width="2" height="12"/></svg>
                Barcode (Code 128)
              </button>
              <button type="button" class="gen-subtab" id="genSubtabQr" onclick="switchGenerateMode('qr')">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;margin-right:6px;vertical-align:-2px;"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="3" height="3"/><rect x="18" y="18" width="3" height="3"/></svg>
                QR Code (2D)
              </button>
            </div>

            <!-- MODE A: Code 128 Barcode -->
            <div id="generateBarcodeMode">
              <div class="section-label">Code 128 Barcode <span>Single Label</span></div>
              <div class="d-flex gap-2 mb-3">
                <div class="scan-input-wrap flex-grow-1">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h3M17 4h3v3M20 17v3h-3M7 20H4v-3"/><rect x="9" y="9" width="6" height="6"/></svg>
                  <input type="text" id="barcodeNumber" style="text-transform:uppercase" class="scan-input mono" value="<%= (tracking ? tracking : '') %>" placeholder="Start typing tracking number..." aria-label="tracking">
                  <button type="button" class="ocr-btn" onclick="openSlimOcrReader('barcodeNumber')" title="Focus & Scan Digits with Camera">
                    <i class="bi bi-camera"></i>
                  </button>
                </div>
                <button onclick="trackPackage()" id="trackPackageBtn" class="btn primary disabled" style="flex:0 0 auto; padding:10px 18px;">Track</button>
              </div>
              <input disabled type="text" id="barcodeBrand" style="text-transform:uppercase" class="d-none d-print-none form-control" placeholder="Brand Name">

              <div class="text-center d-print-none mt-3" id="printArea" style="display: none; background:var(--paper); border:1px solid var(--line); border-radius:12px; padding:18px;">
                <canvas class="pb-2 pt-0" id="barcode" style="max-width:100%;"></canvas>
              </div>

              <div class="text-center mt-3 d-print-none">
                <button class="btn ghost disabled w-100" id="printButton" data-bs-toggle="modal" data-bs-target="#printModal" onclick="clearNameField()">Export Barcode</button>
              </div>
            </div>

            <!-- MODE B: QR Code -->
            <div id="generateQrMode" style="display:none;">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="section-label mb-0">QR Code <span>2D Matrix</span></div>
                <button class="btn-icon text-muted" id="qrSettingsBtn" title="QR Code Settings" onclick="$('#qrSettingsPanel').slideToggle('fast')">
                  <i class="bi bi-gear-fill" style="font-size:1.15rem;"></i>
                </button>
              </div>
              <div class="mb-3 scan-input-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h3M17 4h3v3M20 17v3h-3M7 20H4v-3"/><rect x="9" y="9" width="6" height="6"/></svg>
                <input type="text" id="qrInput" class="scan-input mono" placeholder="Enter text or URL to generate QR code">
                <button type="button" class="ocr-btn" onclick="openSlimOcrReader('qrInput')" title="Focus & Scan Text or QR Code">
                  <i class="bi bi-camera"></i>
                </button>
              </div>
              <!-- Settings Panel -->
              <div id="qrSettingsPanel" class="p-3 mb-3 rounded" style="display:none; background: var(--paper); border: 1px solid var(--line);">
                <div class="row g-2">
                  <div class="col-6">
                    <label class="small text-muted mb-1" style="font-size:.78rem; font-weight:600;">Dark Color</label>
                    <input type="color" id="qrColorDark" class="form-control form-control-color w-100" value="#000000">
                  </div>
                  <div class="col-6">
                    <label class="small text-muted mb-1" style="font-size:.78rem; font-weight:600;">Light Color</label>
                    <input type="color" id="qrColorLight" class="form-control form-control-color w-100" value="#ffffff">
                  </div>
                  <div class="col-6 mt-2">
                    <label class="small text-muted mb-1" style="font-size:.78rem; font-weight:600;">Error Correction</label>
                    <select id="qrCorrection" class="form-select form-select-sm" style="font-size:.82rem;">
                      <option value="L">Low (L)</option>
                      <option value="M" selected>Medium (M)</option>
                      <option value="Q">Quartile (Q)</option>
                      <option value="H">High (H)</option>
                    </select>
                  </div>
                  <div class="col-6 mt-2">
                    <label class="small text-muted mb-1" style="font-size:.78rem; font-weight:600;">Margin</label>
                    <input type="number" id="qrMargin" class="form-control form-control-sm" value="2" min="0" max="10">
                  </div>
                </div>
              </div>

              <div class="p-0 m-auto text-center mt-2" id="qrPrintArea" style="display: none;">
                <canvas class="pb-2 pt-0" id="qrCanvas" style="max-width:100%; border-radius: 8px;"></canvas>
              </div>

              <div class="text-center d-print-none mt-3">
                <button class="btn ghost disabled w-100" id="exportQrBtn" onclick="exportQrCode()">Export to PNG</button>
              </div>
            </div>

          </div>

          <section id="trackingInfoDisplay">
            <div class="panel mt-2 text-start">
              <div class="section-label">Tracking History <span>Events</span></div>
              <div class="list-group placeholder-wave" id="trackingDetails"></div>
            </div>
            
            <div class="modal fade" id="trackingPictureModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
              <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                  <div>
                    <img id="trackingPicture" src="" class="img-fluid" alt="Proof of delivery">
                  </div>
                  <div class="modal-footer d-print-none">
                    <button type="button" class="btn ghost btn-sm" data-bs-dismiss="modal">Close</button>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>

        <!-- 3. BULK TASK TAB -->
        <div class="tab-pane fade" id="bulk-task" role="tabpanel" aria-labelledby="bulk-task-tab">
          <div class="panel d-print-none">
            <div class="section-label">Bulk Task <span>Batch Label Sheet</span></div>
            <div class="mb-3">
              <textarea class="form-control mono" style="font-size:12.5px; border-radius:10px; border-color:var(--line);" placeholder="One entry per line:&#10;'123456789'&#10;'123456789, 1234 Bluejay Dr, NW, Atlanta'" id="barcodesBatchText" rows="6"></textarea>
            </div>
            <button onclick="processBatch()" class="btn primary w-100">Display Barcodes</button>
          </div>

          <div class="panel pt-3">
            <div class="label-toolbar d-print-none">
              <button class="btn ghost btn-sm disabled" id="bulkPrintBtn" onclick="printBulkLabels()">Print Labels</button>
              <button class="btn ghost btn-sm disabled" id="bulkPdfBtn" onclick="exportBulkPdf()">Export as PDF</button>
              <select id="scrollSpeed" class="form-select form-select-sm d-inline-block w-auto ms-auto" style="font-size:.82rem; border-color:var(--line);" disabled>
                <option value="1">Slow</option>
                <option value="2.5" selected>Medium</option>
                <option value="4.5">Fast</option>
                <option value="7">Super Fast</option>
              </select>
              <button class="btn ghost btn-sm disabled" id="autoScrollBtn" onclick="toggleAutoScroll()">Auto Scroll</button>
              <span class="label-count mono" id="bulkLabelCount"></span>
            </div>
            <div class="pt-2" id="batchBarcodeDisplay">
              <p class="label-empty">Paste barcode entries above and tap Display Barcodes to generate a label sheet.</p>
            </div>
          </div>
        </div>

        <!-- 4. SCANNER TAB -->
        <div class="tab-pane fade" id="scanner" role="tabpanel" aria-labelledby="scanner-tab">
          <div class="panel p-2" style="height: calc(100vh - 170px); min-height: 520px;">
            <iframe src="<%= body.domain %>/scanner.html" style="width: 100%; height: 100%; border: none; border-radius:10px;"></iframe>
          </div>
        </div>

        <!-- 5. DELIMITER TAB -->
        <div class="tab-pane fade" id="delimeter" role="tabpanel" aria-labelledby="delimeter-tab">
          <div class="panel">
            <div class="section-label">Delimiter <span>Reformat Text</span></div>
            <div class="mb-3">
              <textarea class="form-control mono" style="font-size:13px; border-radius:10px; border-color:var(--line);" placeholder="One entry per line:&#10;'Santi - 30338 30346 30360 - 115'" id="delimeterText" rows="6"></textarea>
            </div>
            <div class="d-flex gap-2">
              <button onclick="processDelimeter()" class="btn primary">Reformat</button>
              <button onclick="copyDelimeterOutput()" class="btn ghost" id="delimeterCopyBtn">Copy Output</button>
            </div>
            <div id="outputText"></div>
          </div>
        </div>

        <!-- 6. BRAND FINDER TAB -->
        <div class="tab-pane fade" id="brand-finder" role="tabpanel" aria-labelledby="brand-finder-tab">
          <div class="panel">
            <div class="section-label">Brand Finder <span>Carrier Prefix Lookup</span></div>
            <div class="scan-input-wrap mb-3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
              <input type="text" id="brandFinderInput" class="scan-input mono" style="text-transform:uppercase" placeholder="Search carrier by barcode prefix...">
            </div>
            <div class="p-3 bg-light rounded text-center border">
              <p class="mb-0 fw-bold mono" id="brand" style="color:var(--accent);">Type a barcode above to identify carrier</p>
            </div>
          </div>
        </div>


      </div>
    </div>

    <!-- Redesigned Bottom Tab Bar (Driver/Ops navigation pattern) -->
    <nav class="navbar d-print-none">
      <div class="navitem <%= activeTab === 'preload-scan' ? 'active' : '' %>" data-tab="preload-scan-tab">
        <svg viewBox="0 0 24 24"><path d="M3 10l9-7 9 7v10a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1z"/></svg>
        Manifest
      </div>
      <div class="navitem" data-tab="bulk-task-tab">
        <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h10M4 18h16"/></svg>
        Bulk Task
      </div>
      <div class="navitem-center" data-tab="scanner-tab">
        <div class="fab">
          <svg viewBox="0 0 24 24"><path d="M4 7V4h3M17 4h3v3M20 17v3h-3M7 20H4v-3"/><rect x="9" y="9" width="6" height="6"/></svg>
        </div>
        <span>Scan</span>
      </div>
      <div class="navitem <%= activeTab === 'generate' ? 'active' : '' %>" data-tab="generate-tab">
        <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        Generate
      </div>
      <div class="navitem" data-tab="more-tab" data-bs-toggle="modal" data-bs-target="#moreToolsModal">
        <svg viewBox="0 0 24 24"><circle cx="5" cy="7" r="1.5"/><circle cx="5" cy="12" r="1.5"/><circle cx="5" cy="17" r="1.5"/><path d="M10 7h10M10 12h10M10 17h10"/></svg>
        More
      </div>
    </nav>

    <!-- MORE TOOLS MODAL -->
    <div class="modal fade" id="moreToolsModal" tabindex="-1" aria-labelledby="moreToolsModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="moreToolsModalLabel"><i class="bi bi-grid-fill me-2" style="color:var(--accent);"></i>All Tools</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-3">
            <div class="row g-2">
              <div class="col-6">
                <button class="btn ghost w-100 py-3 flex-column gap-2" onclick="switchToTab('brand-finder-tab'); $('#moreToolsModal').modal('hide');">
                  <i class="bi bi-search fs-3" style="color:var(--blue);"></i>
                  <span>Brand Finder</span>
                </button>
              </div>
              <div class="col-6">
                <button class="btn ghost w-100 py-3 flex-column gap-2" onclick="switchToTab('delimeter-tab'); $('#moreToolsModal').modal('hide');">
                  <i class="bi bi-distribute-vertical fs-3" style="color:var(--success);"></i>
                  <span>Delimiter</span>
                </button>
              </div>
              <div class="col-6">
                <button class="btn ghost w-100 py-3 flex-column gap-2" onclick="switchToGenerateMode('qr'); $('#moreToolsModal').modal('hide');">
                  <i class="bi bi-qr-code-scan fs-3" style="color:var(--accent);"></i>
                  <span>QR Code</span>
                </button>
              </div>
              <div class="col-6">
                <button class="btn ghost w-100 py-3 flex-column gap-2" onclick="switchToTab('bulk-task-tab'); $('#moreToolsModal').modal('hide');">
                  <i class="bi bi-card-checklist fs-3" style="color:var(--warn);"></i>
                  <span>Bulk Task</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- MODALS -->
    <div class="modal fade" id="printModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">Export Barcode</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <canvas class="pb-4 pt-0" id="barcodeDuplicate" style="max-width: 100%;"></canvas>
            <div class="input-group">
              <input type="text" id="barcodeName" class="form-control" placeholder="Filename (optional)" aria-label="name">
              <span class="input-group-text">.png</span>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn ghost btn-sm" data-bs-dismiss="modal">Close</button>
            <a id="downloadButton" download="barcode.png" class="btn primary btn-sm">Download PNG</a>
          </div>
        </div>
      </div>
    </div>

    <!-- PRELOAD COMPLETION MODAL -->
    <div class="modal fade" id="preloadCompleteModal" tabindex="-1" aria-labelledby="preloadCompleteModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="preloadCompleteModalLabel">
              <i class="bi bi-check-circle-fill text-success me-2"></i>Preload Summary
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="stat-strip mb-3">
              <div class="stat-cell">
                <div class="stat-num" id="modalTotalCount">0</div>
                <div class="stat-label">Total</div>
              </div>
              <div class="stat-cell">
                <div class="stat-num" style="color:var(--success)" id="modalScannedCount">0</div>
                <div class="stat-label">Scanned</div>
              </div>
              <div class="stat-cell">
                <div class="stat-num" style="color:var(--warn)" id="modalMissingCount">0</div>
                <div class="stat-label">Missing</div>
              </div>
              <div class="stat-cell">
                <div class="stat-num" style="color:var(--blue)" id="modalRatePercent">0%</div>
                <div class="stat-label">Rate</div>
              </div>
            </div>

            <!-- Universal Route & Manifest Exports -->
            <div class="mb-3 p-2 bg-light rounded border">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small fw-bold text-muted" style="font-size:11px;">Export To Routing / Box Services:</span>
              </div>
              <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="exportUniversalManifest('circuit')">
                  <i class="bi bi-signpost-split me-1"></i>Spoke / Circuit (CSV)
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="exportUniversalManifest('roadwarrior')">
                  <i class="bi bi-compass me-1"></i>RoadWarrior (CSV)
                </button>
                <button type="button" class="btn btn-sm btn-outline-success" onclick="exportUniversalManifest('xlsx')">
                  <i class="bi bi-file-earmark-excel me-1"></i>Clean XLSX
                </button>
              </div>
            </div>

            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="small fw-bold text-muted mb-0">Pre-scanned Barcodes List</label>
                <div class="d-flex gap-2">
                  <button class="btn ghost btn-sm py-1 px-2" style="font-size:12px;" onclick="copyPreloadScannedList()">
                    <i class="bi bi-clipboard me-1"></i>Copy
                  </button>
                  <button class="btn ghost btn-sm py-1 px-2" style="font-size:12px;" onclick="downloadPreloadScannedTxt()">
                    <i class="bi bi-download me-1"></i>Download .txt
                  </button>
                </div>
              </div>
              <textarea id="preloadCompleteBarcodeList" class="form-control mono" rows="6" style="font-size: 12px;" readonly></textarea>
            </div>

            <div class="p-3 bg-light rounded border text-center">
              <div class="mb-2 fw-semibold text-dark" style="font-size:13.5px;">
                Ready for loading? Transfer these scanned barcodes straight to Bulk Task:
              </div>
              <button class="btn primary btn-sm fw-bold" onclick="sendPreloadToBulkTask()">
                <i class="bi bi-arrow-right-circle-fill me-1"></i>Send to Bulk Task for Final Load Scan
              </button>
            </div>
          </div>
          <div class="modal-footer d-flex justify-content-between">
            <button type="button" class="btn ghost btn-sm" data-bs-dismiss="modal">Close</button>
            <button type="button" class="btn primary btn-sm" id="preloadExportPdfBtn" onclick="exportPreloadPdf()">
              <i class="bi bi-file-earmark-pdf-fill me-1"></i>Download Scannable Barcodes (PDF)
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- SLIM-LINE OCR & BARCODE READER MODAL -->
    <div class="modal fade" id="ocrReaderModal" tabindex="-1" aria-labelledby="ocrReaderModalLabel" aria-hidden="true" data-bs-backdrop="static">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
          <div class="modal-header py-2 px-3" style="background:var(--paper); border-bottom:1px solid var(--line);">
            <h6 class="modal-title fw-bold mb-0 d-flex align-items-center" id="ocrReaderModalLabel" style="font-size:14px;">
              <i class="bi bi-bounding-box me-2" style="color:var(--accent); font-size:16px;"></i>Scan Barcode / Tracking Number
            </h6>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeSlimOcrReader()"></button>
          </div>
          <div class="modal-body p-3">
            
            <!-- MODE 1: Live Viewfinder with Slim Aiming Reticle (Tap anywhere to capture) -->
            <div id="ocrLiveCamSection">
              <div class="ocr-cam-wrap" id="ocrCamWrap" onclick="captureAndExtractSlimOcr()" title="Tap anywhere to capture and scan" style="cursor:pointer;">
                <video id="ocrVideo" playsinline muted autoplay></video>
                
                <!-- Translucent mask with illuminated slim horizontal targeting slit -->
                <div class="ocr-aim-overlay">
                  <div class="ocr-aim-box" id="ocrAimBox">
                    <div class="ocr-aim-corner tl"></div>
                    <div class="ocr-aim-corner tr"></div>
                    <div class="ocr-aim-corner bl"></div>
                    <div class="ocr-aim-corner br"></div>
                    <div class="ocr-aim-line"></div>
                    <span class="ocr-aim-hint">Align barcode digits here</span>
                  </div>
                </div>

                <!-- Camera Loading / Status Message -->
                <div class="ocr-cam-status" id="ocrCamStatus" style="display:none;">
                  <div class="spinner-border spinner-border-sm text-light mb-2" role="status"></div>
                  <div id="ocrCamStatusText">Starting camera...</div>
                </div>

                <!-- Touch anywhere prompt -->
                <div class="ocr-tap-hint">
                  <i class="bi bi-hand-index-thumb me-1"></i>Tap screen or shutter below to capture
                </div>
              </div>
            </div>

            <!-- MODE 2: Interactive Uploaded Picture Cropper & Area Selector -->
            <div id="ocrUploadContainer" style="display:none;">
              <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                <span class="small fw-bold text-muted" style="font-size:11.5px;">Adjust Slit or Scan Whole Picture:</span>
                <button type="button" class="btn btn-sm btn-link p-0 text-muted" onclick="returnToOcrLiveCamera()" style="font-size:12px; text-decoration:none;">
                  <i class="bi bi-camera me-1"></i>Switch to Live Camera
                </button>
              </div>

              <div class="ocr-upload-img-wrap" id="ocrUploadImgWrap">
                <img id="ocrUploadedImg" alt="Uploaded photo" src="">
                <div class="ocr-upload-crop-box" id="ocrUploadCropBox">
                  <div class="ocr-aim-corner tl"></div>
                  <div class="ocr-aim-corner tr"></div>
                  <div class="ocr-aim-corner bl"></div>
                  <div class="ocr-aim-corner br"></div>
                  <span class="ocr-aim-hint">Drag slit over barcode</span>
                </div>
              </div>

              <!-- Crop slider for vertical placement -->
              <div class="px-2 pt-2">
                <div class="d-flex justify-content-between small text-muted mb-1" style="font-size:11px;">
                  <span><i class="bi bi-arrows-vertical me-1"></i>Slit Position</span>
                  <span id="ocrCropPosLabel">Center</span>
                </div>
                <input type="range" class="form-range" id="ocrCropSlider" min="5" max="95" value="50" oninput="updateCropPositionFromSlider(this.value)">
              </div>

              <!-- Action buttons for uploaded image -->
              <div class="d-flex gap-2 mt-2">
                <button type="button" class="btn primary flex-grow-1 py-2 fw-bold" id="ocrScanSelectedBtn" onclick="scanSelectedUploadArea()">
                  <i class="bi bi-crop me-1"></i>Scan Selected Slit
                </button>
                <button type="button" class="btn ghost flex-grow-1 py-2 fw-bold" id="ocrScanFullBtn" onclick="scanEntireUploadImage()">
                  <i class="bi bi-aspect-ratio me-1"></i>Scan Full Picture
                </button>
              </div>
            </div>

            <!-- BOTTOM THUMB-FRIENDLY ACTION BAR (No hand stretching!) -->
            <div class="d-flex align-items-center justify-content-between gap-2 mt-3" id="ocrActionRow">
              <!-- Left: Gallery Upload Icon -->
              <label class="btn ghost ocr-side-btn mb-0" title="Upload from Photo Gallery" style="cursor:pointer;">
                <i class="bi bi-image"></i>
                <input type="file" accept="image/*" id="ocrUploadFallbackInput" class="d-none" onchange="handleOcrImageUpload(event)">
              </label>

              <!-- Center: Large Thumb Shutter Button (Where thumb naturally rests) -->
              <button type="button" class="btn primary ocr-shutter-btn flex-grow-1" id="ocrCaptureBtn" onclick="captureAndExtractSlimOcr()">
                <i class="bi bi-camera-fill me-2 fs-5"></i>
                <span>Capture & Read</span>
              </button>

              <!-- Right: Torch / Flashlight Toggle Button -->
              <button type="button" class="btn ghost ocr-side-btn mb-0" id="ocrTorchBtn" onclick="toggleOcrTorch()" title="Toggle Flashlight" style="display:none;">
                <i class="bi bi-lightning-charge"></i>
              </button>
            </div>

            <!-- RESULT / CONFIRMATION SECTION -->
            <div id="ocrResultArea" class="mt-3 p-3 rounded border" style="display:none; background:var(--paper);">
              
              <!-- Detected Barcode / Tracking Number Candidates (List of tap-to-select pills) -->
              <div id="ocrCandidateSection" class="mb-2" style="display:none;">
                <span class="small fw-bold text-muted d-block mb-1" style="font-size:11px;">
                  <i class="bi bi-upc-scan me-1" style="color:var(--accent);"></i>Detected Barcode(s) — Tap to Select:
                </span>
                <div class="d-flex flex-wrap gap-1" id="ocrCandidateList"></div>
              </div>

              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small fw-bold text-muted" style="font-size:11px;">Scanned Snippet:</span>
                <span class="badge" id="ocrResultTypeBadge" style="background:var(--accent); font-size:10px;">Analyzing...</span>
              </div>
              <div class="text-center mb-2" style="background:#000; border-radius:6px; overflow:hidden; max-height:55px; border:1px solid var(--line);">
                <canvas id="ocrSnippetCanvas" style="max-width:100%; height:auto; display:inline-block;"></canvas>
              </div>
              
              <div class="mb-2">
                <label class="small fw-bold text-muted mb-1" style="font-size:11px;">Selected Tracking Number:</label>
                <div class="input-group input-group-sm">
                  <input type="text" id="ocrDetectedInput" class="form-control mono fw-bold" placeholder="Reading digits..." style="font-size:13px; text-transform:uppercase;">
                  <button class="btn primary px-3 fw-bold" type="button" onclick="applyOcrResult()">Use This</button>
                </div>
              </div>

              <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top">
                <button type="button" class="btn btn-link btn-sm p-0 text-muted" onclick="resumeOcrCamera()" style="font-size:12px; text-decoration:none;">
                  <i class="bi bi-arrow-repeat me-1"></i>Retake / Aim Again
                </button>
                <button type="button" class="btn btn-link btn-sm p-0 text-danger" onclick="closeSlimOcrReader()" style="font-size:12px; text-decoration:none;">
                  Close
                </button>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>

    <!-- Toast Notification Element -->
    <div id="appToast" class="d-print-none"></div>

  </main>

  <!-- JavaScript Bundle with Popper -->
  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
  <!-- jQuery -->
  <script defer src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
  <!-- Barcode Tool Engine -->
  <script defer src="<%= body.domain %>/js/barcode.js?v=<%= Date.now() %>"></script>

  <!-- OCR Script -->
  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

  <!-- PWA Service Worker Registration -->
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('<%= body.domain %>/sw.js')
          .then(reg => console.log('ServiceWorker registered'))
          .catch(err => console.error('ServiceWorker registration failed: ', err));
      });
    }
  </script>

  </body>
  </html>
